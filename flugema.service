[Unit]
Description=Flugema web app
Documentation=https://github.com/Xeladaren/flugema
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flugema
Group=flugema

EnvironmentFile=-/etc/default/flugema

WorkingDirectory=/var/lib/flugema
ExecStart=uv run /opt/flugema/venv/bin/flugema

Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=mixed

[Install]
WantedBy=multi-user.target